  "main": "index.js",
  "scripts": {
    "dev": "tailwindcss -i ./src/input.css -o ./dist/css/style.css --watch",
    "build": "tailwindcss -i ./src/input.css -o ./dist/css/style.css --minify",
    "copy:js": "cp src/js/main.js dist/js/",
    "watch:js": "nodemon --watch src/js --ext js --exec 'npm run copy:js'",
